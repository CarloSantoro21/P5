{
  "name": "p5-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:prod": "wrangler deploy --env production",
    "test:uat": "vitest run --config vitest.uat.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-istanbul": "^4.1.11",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "workerd@1.20260917.1": true,
    "workerd@1.20260815.1": true,
    "esbuild@0.28.1": true
  }
}
